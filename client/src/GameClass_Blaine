class Game
{
public:
	Food food = Food(snake1.body, snake2.body);
	Snake snake1 = Snake(24, 1, 24, 0, 24, -1, 0, 1);
	Snake snake2 = Snake(0, 22, 0, 23, 0, 24, 0, -1);

	bool running = true;

	void draw()
	{
		food.draw();
		snake1.draw();
		snake2.draw();
	}

	void update()
	{
		if (running)
		{
			FoodCollision(snake1);
			FoodCollision(snake2);
			WallCollision(snake1);
			WallCollision(snake2);
			SnakeCollision(snake1, snake1.body, snake2.body);
			SnakeCollision(snake2, snake1.body, snake2.body);
			snake1.update();
			snake2.update();
		}
	}

	void FoodCollision(Snake snake)
	{
		if (Vector2Equals(snake.body[0], food.position))
		{
			food.position = food.GenerateRandomPos(snake1.body, snake2.body);
			snake.addSegment = true;
		}
	}


	void WallCollision(Snake snake)
	{
		if (snake.body[0].x == cellCount || snake.body[0].x == -1)
		{
			GameOver();
		}
		if (snake.body[0].y == cellCount || snake.body[0].y == -1)
		{
			GameOver();
		}
	}

	void SnakeCollision(Snake snake, deque<Vector2> snake1Body, deque<Vector2> snake2Body)
	{
		if (elementInDeque((snake.body[0] + snake.direction), snake1Body) || elementInDeque((snake.body[0] + snake.direction), snake2Body))
		{
			GameOver();
		}
	}

	void reset()
	{
		snake1.reset(24, 2, 24, 1, 24, 0, 0, 1);
		snake2.reset(0, 22, 0, 23, 0, 24, 0, -1);
	}

	void GameOver()
	{
		reset();
		food.position = food.GenerateRandomPos(snake1.body, snake2.body);
		running = false;
	}

	void snake1Control()
	{
		if (IsKeyPressed(KEY_UP) && snake1.direction.y != 1)
		{
			snake1.direction = { 0, -1 };
		}
		if (IsKeyPressed(KEY_DOWN) && snake1.direction.y != -1)
		{
			snake1.direction = { 0, 1 };
		}
		if (IsKeyPressed(KEY_LEFT) && snake1.direction.x != 1)
		{
			snake1.direction = { -1, 0 };
		}
		if (IsKeyPressed(KEY_RIGHT) && snake1.direction.x != -1)
		{
			snake1.direction = { 1, 0 };
		}
	}

	void snake2Control()
	{
		if (IsKeyPressed(KEY_W) && snake2.direction.y != 1)
		{
			snake2.direction = { 0, -1 };
		}
		if (IsKeyPressed(KEY_S) && snake2.direction.y != -1)
		{
			snake2.direction = { 0, 1 };
		}
		if (IsKeyPressed(KEY_A) && snake2.direction.x != 1)
		{
			snake2.direction = { -1, 0 };
		}
		if (IsKeyPressed(KEY_D) && snake2.direction.x != -1)
		{
			snake2.direction = { 1, 0 };
		}
	}
};

int main()
{
	cout << "starting game..." << endl;
	InitWindow(cellSize*cellCount, cellSize*cellCount, "Multiplayer Snake");
	SetTargetFPS(60);

	Game game = Game();

	while (WindowShouldClose() == false)
	{
		BeginDrawing();

		if (eventTriggered(0.2))
		{
			game.update();
		}

		game.snake1Control();
		game.snake2Control();

		if (IsKeyPressed(KEY_ENTER))
			game.running = true;

		ClearBackground(green);
		game.draw();


		EndDrawing();
	}

	CloseWindow();

	return 0;
}
