#include "SystemManager.h"


int cellSize = 30;
int cellCount = 25;

SystemManager::SystemManager() = default;

void SystemManager::run() {
    // TODO placeholder for getting room ID
    std::string room_id;
    std::cout << "Enter room ID: ";
    std::cin >> room_id;
    std::cout << std::endl;
    std::cin.clear();
    std::cin.ignore();

    // start WS
    WSClient client("ws://localhost:9001", incoming, outgoing);
    client.setRoomId(room_id);
    try {
        client.run();   // non-blocking
    }
    catch (std::exception& e) {
        std::cerr << e.what() << '\n';
        return;
    }
    std::cout << "Websocket Running..." << std::endl;



    initWindow(cellSize * cellCount, cellSize * cellCount, "Multiplayer Snake");

    snakeGame game(incoming, outgoing);

    while (!WindowShouldClose())
    {
        while (!incoming.empty())
        {
            auto msg = incoming.pop();
            game.handleNetworkMessage(msg);
        }
        game.handleLocalInput();

        client.send();

        if (eventTriggered(0.2))
            game.update();

        BeginDrawing();
        ClearBackground(Green);
        game.draw();
        EndDrawing();
    }
    CloseWindow();
  }
